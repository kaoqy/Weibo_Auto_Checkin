# ============================================================
# 微博签到管理面板 · Docker 部署环境变量
# 复制为 .env 后按需修改（.env 已被 .gitignore 忽略，不会提交）
# ============================================================

# ---- 服务端口 ----
WCM_PORT=8000

# ---- 管理员账号（首次启动创建，之后不再改）----
# 若 WCM_ADMIN_PASSWORD 为空，则首启会生成随机密码并打印到日志
WCM_ADMIN_USER=admin
WCM_ADMIN_PASSWORD=

# ---- 镜像仓库（不含 tag，push.sh 会自动加日期-序号 tag 并更新 latest）----
# 示例：
#   Docker Hub:        docker.io/kaoqy666/weibo-checkin
#   GitHub Container:  ghcr.io/kaoqy666/weibo-checkin
#   私有 registry:     registry.example.com/weibo-checkin
WCM_IMAGE_BASE=kaoqy666/weibo-checkin

# ---- 保留几个版本 tag（push.sh 清理时用，默认 5）----
KEEP_TAGS=5

# ---- 远程服务器（可选，用于一键远程部署）----
# 格式: user@host，例如 root@1.2.3.4
WCM_DEPLOY_HOST=

# ---- 远程数据目录（挂载到服务器）----
WCM_REMOTE_DATA=/opt/weibo-checkin/data
