# ============================================================
# 微博签到管理面板 · Docker 部署环境变量
# 复制为 .env 后按需修改（.env 已被 .gitignore 忽略，不会提交）
# ============================================================

# ---- 服务端口 ----
WCM_PORT=8000

# ---- 镜像仓库（二选一填写）----
# 示例：
#   Docker Hub:        docker.io/yourname/weibo-checkin
#   GitHub Container:  ghcr.io/yourname/weibo-checkin
#   私有 registry:     registry.example.com/weibo-checkin
WCM_IMAGE=weibo-checkin:latest

# ---- 远程服务器（可选，用于一键远程部署）----
# 格式: user@host，例如 root@1.2.3.4
WCM_DEPLOY_HOST=

# 远程部署时，镜像在服务器上的名字（可用 .env 里 WCM_IMAGE 相同）
WCM_REMOTE_IMAGE=weibo-checkin:latest

# ---- 远程数据目录（挂载到服务器）----
WCM_REMOTE_DATA=/opt/weibo-checkin/data
